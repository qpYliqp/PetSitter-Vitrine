---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  faqSchema?: object[];
}

const {
  title = "Pet Sitter Dordogne | Gardiennage Chien & Pension à Mensignac",
  description = "Recherche un Pet Sitter en Dordogne ? Sandrine vous propose le gardiennage de chiens, pension canine sans box et garde d'animaux à Mensignac, près de Périgueux.",
  image = "/illustrations/galerie-cover.jpg",
  type = "website",
  faqSchema,
} = Astro.props;
const canonicalURL = new URL(
  Astro.url.pathname,
  "https://pet-sitter-dordogne.fr"
);
const baseUrl = "https://pet-sitter-dordogne.fr";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "AnimalShelter"],
  "@id": baseUrl + "/#business",
  name: "Au Bonheur Canin – Pet Sitter Dordogne",
  alternateName: "Gardiennage Chien Dordogne Mensignac",
  image: new URL("/illustrations/galerie-cover.jpg", baseUrl).href,
  url: baseUrl,
  telephone: "+33600000000",
  email: "sandrine.bonheur.canin@gmail.com",
  priceRange: "15€ - 20€",
  currenciesAccepted: "EUR",
  paymentAccepted: "Cash, Virement bancaire",
  openingHours: "Mo-Su 08:00-20:00",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Mensignac",
    addressLocality: "Mensignac",
    postalCode: "24520",
    addressRegion: "Dordogne",
    addressCountry: "FR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 45.1931,
    longitude: 0.5615,
  },
  areaServed: [
    { "@type": "City", name: "Périgueux" },
    { "@type": "City", name: "Mensignac" },
    { "@type": "AdministrativeArea", name: "Dordogne" },
  ],
  description:
    "Pet sitter certifiée ACACED en Dordogne. Au Bonheur Canin propose la pension canine, garderie de chiens et garde d'animaux à domicile à Mensignac près de Périgueux (24).",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services de garde d'animaux et de gardiennage",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Pension pour chien en Dordogne (Hébergement complet)",
          description:
            "Gardiennage de votre chien en maison familiale à Mensignac. Jardin clos, balades, pas de box.",
        },
        price: "20.00",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "20.00",
          priceCurrency: "EUR",
          unitText: "DAY",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Garderie pour chien (Journée)",
          description: "Garde de jour pour chiens à Mensignac.",
        },
        price: "15.00",
        priceCurrency: "EUR",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: "15.00",
          priceCurrency: "EUR",
          unitText: "DAY",
        },
      },
    ],
  },
  sameAs: ["https://www.facebook.com/profile.php?id=61580176229405#"],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    reviewCount: "30",
    bestRating: "5",
    worstRating: "1",
  },
};

const faqPageSchema = faqSchema
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: faqSchema,
    }
  : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sandrine – Au Bonheur Canin" />
    <meta
      name="keywords"
      content="pet sitter dordogne, gardiennage chien dordogne, pension pour chien dordogne, garde animaux mensignac, pet sitter périgueux, garde de chien dordogne, pension canine 24520"
    />
    <link rel="canonical" href={canonicalURL} />

    <meta name="geo.region" content="FR-24" />
    <meta name="geo.placename" content="Mensignac, Dordogne, France" />
    <meta name="geo.position" content="45.1931;0.5615" />
    <meta name="ICBM" content="45.1931, 0.5615" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, baseUrl)} />
    <meta property="og:locale" content="fr_FR" />
    <meta
      property="og:site_name"
      content="Au Bonheur Canin – Pet Sitter Dordogne"
    />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, baseUrl)} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />

    {
      faqPageSchema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqPageSchema)}
        />
      )
    }
  </head>
  <body><slot /></body>
</html>
