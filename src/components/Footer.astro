---
import ContactLink from "./shared/ContactLink.astro";
---
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        <span class="text-third">Contactez-moi</span>
      </h2>
    </div>
<footer
  id="contact"
  class="bg-footer text-slate-300 font-sans relative overflow-hidden"
>
  <div class="h-1 w-full bg-third"></div>

  <div class="max-w-7xl mx-auto px-6 py-16">
    <div
      class="flex flex-col lg:flex-row justify-between items-start gap-12 mb-12"
    >
      <div class="w-full lg:w-5/12 space-y-6">
        <h3 class="text-3xl font-bold text-white tracking-tight">
          <span class="bg-third">Pet </span> <span class="text-third">Sitter 24</span>
        </h3>
        <p class="text-lg leading-relaxed text-slate-400 max-w-sm">
          Si vous souhaitez plus d'informations, vous pouvez consulter mes réseaux ci-dessous.
        </p>

        <div class="flex flex-col gap-4 pt-2">
          <ContactLink
            label="Facebook"
            iconName="facebook"
            link="https://www.instagram.com/full_depannage/"
            userName="Ma page Facebook"
          />
          <ContactLink
            label="Rover"
            iconName="Rover"
            link="https://www.snapchat.com/add/fulll_depannage"
            userName="Ma page Rover"
          />
        </div>
      </div>

    </div>

    <div class="border-t border-white/10 pt-8">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500"
      >
        <p>© 2025 PetSitter24. Tous droits réservés.</p>
      </div>
    </div>
  </div>
</footer>