---
import ContactLink from "./shared/ContactLink.astro";
import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();
---

<footer
  id="contact"
  class="bg-footer text-slate-300 font-sans relative overflow-hidden mt-10"
>
  <div class="h-1.5 w-full bg-linear-to-r from-third via-amber-600 to-third">
  </div>

  <div
    class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 rounded-full bg-third/5 blur-3xl pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-third/5 blur-3xl pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 relative z-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-16"
    >
      <div class="lg:col-span-5 space-y-6">
        <a href="/" class="inline-block">
          <h3
            class="text-3xl font-bold text-white tracking-tight flex items-center gap-3"
          >
            <span class="bg-third py-1.5 px-3 rounded-xl">Au</span>
            <span class="text-third">Bonheur Canin</span>
          </h3>
        </a>
        <p class="text-lg leading-relaxed text-slate-400 max-w-sm">
          Votre oasis de bonheur pour animaux en Dordogne. Je propose une
          pension canine familiale sans box et un service de pet sitting
          bienveillant, certifié ACACED.
        </p>

        {/* Réseaux sociaux */}
        <div class="flex flex-col gap-4 pt-2">
          <ContactLink
            label="Facebook"
            iconName="facebook"
            link="https://www.facebook.com/profile.php?id=61580176229405#"
            userName="Ma page Facebook"
          />
        </div>
      </div>

      {/* Colonne 2 : Liens Rapides */}
      <div class="lg:col-span-3 space-y-6">
        <h4 class="text-xl font-bold text-white border-b border-white/10 pb-4">
          Navigation
        </h4>
        <nav class="flex flex-col gap-4">
          <a
            href="/#home"
            class="text-slate-400 hover:text-white transition-colors"
          >
            Accueil
          </a>
          <a
            href="/#services"
            class="text-slate-400 hover:text-white transition-colors"
          >
            Mes Services
          </a>
          <a
            href="/tarifs"
            class="text-slate-400 hover:text-white transition-colors"
          >
            Tarifs & Prestations
          </a>
          <a
            href="/galerie"
            class="text-slate-400 hover:text-white transition-colors"
          >
            Galerie Photos
          </a>
        </nav>
      </div>

      {/* Colonne 3 : Contact & Localisation (SEO Local NAP) */}
      <div class="lg:col-span-4 space-y-6">
        <h4 class="text-xl font-bold text-white border-b border-white/10 pb-4">
          Me Contacter
        </h4>

        <address
          class="not-italic space-y-5"
          itemprop="address"
          itemscope
          itemtype="https://schema.org/LocalBusiness"
        >
          <span itemprop="name" class="sr-only"
            >Au Bonheur Canin – Pet Sitter</span
          >

          <div class="flex items-start gap-4">
            <div
              class="mt-1 flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-third"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
            </div>
            <div>
              <p class="text-sm font-semibold text-white mb-1">Localisation</p>
              <p class="text-slate-400 leading-tight">
                <span itemprop="addressLocality">Mensignac</span>, <span
                  itemprop="addressRegion">Dordogne</span
                ><br />
                <span itemprop="postalCode">24520</span>
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div
              class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-third shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5"
                ><path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                ></path></svg
              >
            </div>
            <div>
              <p class="text-sm font-semibold text-white mb-0.5">Téléphone</p>
              <a
                href="tel:+33622073356"
                class="text-slate-400 hover:text-white transition-colors"
                itemprop="telephone">06 22 07 33 56</a
              >
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div
              class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/5 border border-white/10 text-third shrink-0"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5"
                ><path
                  d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                ></path><polyline points="22,6 12,13 2,6"></polyline></svg
              >
            </div>
            <div>
              <p class="text-sm font-semibold text-white mb-0.5">E-mail</p>
              <a
                href="mailto:sandrine.bonheur.canin@gmail.com"
                class="text-slate-400 hover:text-white transition-colors block truncate"
                itemprop="email">sandrine.bonheur.canin@gmail.com</a
              >
            </div>
          </div>
        </address>
      </div>
    </div>

    {/* Section Bas de page (Copyright & Légal) */}
    <div class="border-t border-white/10 pt-8 mt-4">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500 font-medium"
      >
        <p>
          © {currentYear}
          <span class="text-slate-400">Au Bonheur Canin</span> – Pet Sitter Dordogne.
          Tous droits réservés.
        </p>
        <div class="flex items-center gap-6">
          <p>SIRET : <span class="text-slate-400">10153412100013</span></p>
          <a
            href="#home"
            aria-label="Retour en haut"
            class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 border border-white/10 hover:bg-third hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
              ><polyline points="18 15 12 9 6 15"></polyline></svg
            >
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
