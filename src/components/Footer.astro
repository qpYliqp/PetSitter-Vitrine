---
import ContactLink from "./shared/ContactLink.astro";
---

<footer
  id="contact"
  class="bg-footer text-slate-300 font-sans relative overflow-hidden"
>
  <div class="h-1 w-full bg-third"></div>

  <div class="max-w-7xl mx-auto px-6 py-16">
    <div
      class="flex flex-col lg:flex-row justify-between items-start gap-12 mb-12"
    >
      <div class="w-full lg:w-5/12 space-y-6">
        <h3
          class="text-3xl font-bold text-white tracking-tight flex items-center gap-2"
        >
          <span class="bg-third text-white px-2 py-1 rounded-lg">Pet</span>
          <span class="text-third">Sitter 24</span>
        </h3>
        <p class="text-lg leading-relaxed text-slate-400 max-w-sm">
          Si vous souhaitez plus d'informations, vous pouvez consulter mes
          réseaux ci-dessous.
        </p>

        <div class="flex flex-col gap-4 pt-2">
          <ContactLink
            label="Facebook"
            iconName="facebook"
            link="https://www.facebook.com/profile.php?id=61580176229405#"
            userName="Ma page Facebook"
          />
        </div>
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 mt-8">
      <div
        class="flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-slate-500 font-medium"
      >
        <p>© {new Date().getFullYear()} PetSitter24. Tous droits réservés.</p>
        <p>SIRET : 10153412100013</p>
      </div>
    </div>
  </div>
</footer>
