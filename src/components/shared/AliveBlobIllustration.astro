---
interface Props
{
    imageUrl : string,
}

const {imageUrl} = Astro.props;
---
<div class="blob-container relative overflow-hidden shadow-2xl aspect-square">
    <img class="w-full h-full object-cover" src={imageUrl} alt="Image décorative"/>
</div>

<style>
    .blob-container {
        /* Forme initiale */
        border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        /* Animation : nom | durée | courbe | infini | alterné */
        animation: blob-bounce 8s ease-in-out infinite alternate;
    }

    @keyframes blob-bounce {
        0% {
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        }
        50% {
            border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
        }
        100% {
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        }
    }
</style>