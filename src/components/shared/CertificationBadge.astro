---
import { Icon } from 'astro-icon/components'
interface Props
{
    iconName : string;
    text: string;
}
const {iconName, text} = Astro.props;
---

<div class="flex flex-row px-2 py-1 items-center bg-badge rounded-xl gap-2 w-fit">
    <Icon name={iconName} class="w-6 h-5 text-third"></Icon>
    <p class="font-medium">{text}</p>
</div>