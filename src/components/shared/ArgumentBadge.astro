---
import { Icon } from "astro-icon/components";
interface Props
{
  iconName : string;
  title: string;
  description: string;
}

const {iconName, title, description} = Astro.props;
---

<div class="flex items-start gap-3">
  
  <div class="bg-third/20 rounded-xl flex items-center justify-center w-12 h-12 shrink-0">
    <Icon name={iconName} class="text-third w-8 h-8" />
  </div>

  <div class="flex flex-col">
    <h3 class="text-lg font-bold">{title}</h3> <p class="text-muted-foreground">{description}</p>
  </div>

</div>