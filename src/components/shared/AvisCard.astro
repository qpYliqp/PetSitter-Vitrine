---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  author?: string;
}

const { title, description, author = "Client heureux" } = Astro.props;
---

<div
  class="avis-card relative bg-white p-6 rounded-2xl shadow-md border border-gray-100 flex flex-col gap-4 min-h-[320px] h-fit transition-all duration-300"
  style="opacity: 0; transform: translateY(40px);"
>
  <div
    class="absolute top-4 right-4 opacity-10 text-gray-400 pointer-events-none"
  >
    <Icon name="mdi:format-quote-close" class="size-10" />
  </div>

  <div class="flex text-yellow-400 gap-0.5">
    {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-5" />)}
  </div>

  <div class="flex-1">
    <h3 class="text-lg font-bold text-gray-800 mb-2 font-heading">
      {title}
    </h3>
    <div class="relative">
      <div class="avis-desc-wrapper overflow-hidden">
        <p
          class="avis-description text-gray-600 leading-relaxed text-sm"
        >
          {description}
        </p>
      </div>

      <div class="h-5 mt-1">
        <span
          class="avis-more-indicator text-third text-xs font-bold cursor-pointer transition-opacity duration-300 hidden"
        >
          Lire la suite...
        </span>
        <span
          class="avis-less-indicator text-third text-xs font-bold cursor-pointer transition-opacity duration-300 hidden"
        >
          Réduire
        </span>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-100 pt-4 flex items-center gap-3">
    <div
      class="bg-secondary text-third rounded-full w-8 h-8 flex items-center justify-center font-bold text-xs shrink-0"
    >
      {author.charAt(0)}
    </div>
    <span class="text-sm font-medium">{author}</span>
  </div>
</div>

<style>
  .avis-card {
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .avis-card.revealed {
    opacity: 1 !important;
    transform: translateY(0) !important;
  }

  .avis-desc-wrapper {
    transition: max-height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>

<script>
  function initializeAvisCards() {
    const cards = document.querySelectorAll(".avis-card");

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            const delay = card.dataset.delay || "0";
            setTimeout(() => {
              card.classList.add("revealed");
            }, parseInt(delay));
            observer.unobserve(card);
          }
        });
      },
      { threshold: 0.15 },
    );

    cards.forEach((card, index) => {
      (card as HTMLElement).dataset.delay = String(index * 150);
      observer.observe(card);

      const wrapper = card.querySelector(".avis-desc-wrapper") as HTMLElement;
      const desc = card.querySelector(".avis-description") as HTMLElement;
      const moreInd = card.querySelector(".avis-more-indicator") as HTMLElement;
      const lessInd = card.querySelector(".avis-less-indicator") as HTMLElement;

      if (!desc || !wrapper) return;

      const lineHeight = parseFloat(getComputedStyle(desc).lineHeight) || 20;
      const collapsedHeight = lineHeight * 4;
      const fullHeight = desc.scrollHeight;
      const isOverflowing = fullHeight > collapsedHeight + 4;

      if (isOverflowing) {
        wrapper.style.maxHeight = collapsedHeight + "px";

        moreInd.classList.remove("hidden");
        moreInd.classList.add("block");

        let expanded = false;

        const toggle = () => {
          if (!expanded) {
            wrapper.style.maxHeight = fullHeight + "px";
            moreInd.classList.add("hidden");
            moreInd.classList.remove("block");
            lessInd.classList.remove("hidden");
            lessInd.classList.add("block");
          } else {
            wrapper.style.maxHeight = collapsedHeight + "px";
            lessInd.classList.add("hidden");
            lessInd.classList.remove("block");
            moreInd.classList.remove("hidden");
            moreInd.classList.add("block");
          }
          expanded = !expanded;
        };

        moreInd.addEventListener("click", toggle);
        lessInd.addEventListener("click", toggle);
      }
    });
  }

  setTimeout(initializeAvisCards, 150);
</script>
