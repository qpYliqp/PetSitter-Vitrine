---
interface Props {
  imageUrl: string;
  alt: string;
  description?: string;
}

const { imageUrl, alt, description } = Astro.props;
---

<div
  class="w-full bg-[#fdfdfd] p-3 sm:p-5 pb-16 sm:pb-24 shadow-[0_15px_35px_-5px_rgba(0,0,0,0.08)] border border-slate-100/60 rounded-[3px] relative flex flex-col items-center"
>
  <!-- Élégant bout de scotch semi-transparent -->
  <div
    class="absolute -top-3 left-1/2 -translate-x-1/2 w-16 h-5 bg-third/20 backdrop-blur-sm -rotate-2 z-10 shadow-sm opacity-80"
  ></div>

  <!-- Conteneur de l'image -->
  <div
    class="w-full aspect-3/2 lg:aspect-[16/10] overflow-hidden bg-gray-100 relative shadow-[inset_0_2px_8px_rgba(0,0,0,0.05)] rounded-[2px]"
  >
    <img
      src={imageUrl}
      alt={alt}
      class="w-full h-full object-cover"
      loading="lazy"
    />
  </div>

  <!-- Zone de texte Polaroïd -->
  <div
    class="absolute bottom-0 left-0 w-full h-16 sm:h-24 flex items-center justify-center px-4 sm:px-8"
  >
    <span
      class="tracking-wide text-gray-700 text-sm sm:text-lg md:text-xl text-center leading-snug -rotate-1 opacity-90 font-medium"
    >
      {description}
    </span>
  </div>
</div>
