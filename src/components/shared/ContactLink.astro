---
import { Icon } from 'astro-icon/components'
interface Props {
  label: string;
  iconName: string;
  link: string;
  userName: string;
}

const { label, iconName, link, userName } = Astro.props;
---

<a
    href={link}
    target="_blank"
    rel="noopener noreferrer"
    class="w-fit flex items-center gap-3 group cursor-pointer"
    aria-label={label}
>
  <div
      class="w-10 h-10 rounded-full bg-white/5 group-hover:bg-white/10 flex items-center justify-center transition-all duration-150"
  >
    <Icon name={iconName} class="w-6 h-5 text-third"></Icon>

  </div>

  <span
      class="text-slate-400 text-sm group-hover:text-white transition-all duration-150"
  >
    {userName}
  </span>
</a>