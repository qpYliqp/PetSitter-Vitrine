---
import { faqs } from "../data/faq";
---

<section id="faq" class="py-12 md:py-20" aria-label="Questions fréquentes sur le pet sitting en Dordogne">
  <div class="container mx-auto px-4 max-w-3xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Questions <span class="text-third">fréquentes</span>
      </h2>
      <p class="text-muted-foreground text-lg">
        Tout ce que vous devez savoir sur le gardiennage de chien en Dordogne
      </p>
    </div>

    <dl class="flex flex-col gap-4">
      {faqs.map((faq, i) => (
        <details
          class="group bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden"
          open={i === 0}
        >
          <summary class="flex items-center justify-between gap-4 p-5 md:p-6 cursor-pointer list-none font-semibold text-gray-800 hover:text-third transition-colors duration-200 select-none">
            <dt class="text-left font-bold text-md">{faq.question}</dt>
            <span class="shrink-0 w-6 h-6 rounded-full bg-third/10 text-third flex items-center justify-center transition-transform duration-300 group-open:rotate-45 text-lg leading-none">+</span>
          </summary>
          <dd class="px-5 md:px-6 pb-5 md:pb-6 text-gray-600 leading-relaxed text-sm md:text-base border-t border-gray-50 pt-4">
            {faq.answer}
          </dd>
        </details>
      ))}
    </dl>
  </div>
</section>
