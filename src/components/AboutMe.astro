---
import { Icon } from "astro-icon/components";
import TapedIllustration from "./shared/TapedIllustration.astro";

const tapeStyleTxt =
  "absolute w-12 md:w-16 h-5 md:h-6 bg-third shadow-sm backdrop-blur-[1px] pointer-events-none opacity-70";
---

<section id="home" class="py-12 lg:pt-40 lg:pb-20 relative overflow-hidden">
  <div
    class="absolute inset-0 -z-10 opacity-5 bg-[url('/illustrations/paper-texture.png')] bg-repeat mix-blend-multiply"
  >
  </div>

  <div class="container px-4 mx-auto max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <div
        class="flex flex-col items-center lg:items-start gap-8 text-center lg:text-start relative lg:sticky lg:top-24"
      >
        <h2 class="text-3xl md:text-4xl font-bold mb-2 relative inline-block">
          A propos de
          <span class="text-third relative z-10">moi</span>
          <svg
            class="absolute bottom-0 left-0 w-full h-3 -z-10 text-third/30"
            viewBox="0 0 100 10"
            preserveAspectRatio="none"
          >
            <path
              d="M0 5 Q 25 0, 50 5 T 100 5"
              stroke="currentColor"
              stroke-width="3"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
        </h2>

        <div
          class="relative z-10 transform transition-transform hover:scale-[1.02] duration-300"
        >
          <TapedIllustration
            imageUrl="/illustrations/aboutme.jpg"
            alt="Portrait souriant de Sandrine, votre nounou et Pet Sitter attentionnée en Dordogne"
            width="w-64 md:w-80"
            height="h-64 md:h-80"
          />
        </div>

        <div class="flex flex-col items-center lg:items-start w-full">
          <h2
            class="text-2xl md:text-3xl font-bold mt-4 mb-6 relative inline-block"
          >
            Je garde ces
            <span class="text-third relative z-10">types d'animaux</span> :
          </h2>

          <div
            class="flex flex-wrap justify-center lg:justify-start gap-4 md:gap-6"
          >
            <div class="flex flex-col items-center gap-2">
              <Icon
                name="pixel-dog"
                class="w-24 h-24 md:w-32 md:h-32 hover:animate-buzzy transition-transform hover:scale-110"
              />
            </div>
            <div class="flex flex-col items-center gap-2">
              <Icon
                name="pixel-bird"
                class="w-27 h-27 md:w-35 md:h-35 hover:animate-buzzy transition-transform hover:scale-110"
              />
            </div>
            <div class="flex flex-col items-center gap-2">
              <Icon
                name="pixel-rabbit"
                class="w-24 h-24 md:w-32 md:h-32 hover:animate-buzzy transition-transform hover:scale-110"
              />
            </div>
          </div>
          <h2
            class="text-2xl md:text-3xl font-bold mt-15 text-third relative inline-block"
          >
            Certifications :
          </h2>
          <img
            src="illustrations/acaced.png"
            alt="Certificat officiel ACACED pour la garde des animaux de compagnie"
            class="w-35 hover:animate-[spin_10s_linear_infinite]"
          />
        </div>
      </div>

      <div class="flex flex-col gap-10 md:gap-12 mt-4 lg:mt-0 relative">
        <div
          class="relative transition rotate-2 hover:rotate-0 hover:scale-[1.02] duration-300 ease-out mb-10 bg-white p-6 md:p-10 shadow-[2px_4px_15px_rgba(0,0,0,0.08)] rounded-sm border border-gray-100 max-w-2xl mx-auto lg:mx-0"
        >
          <div
            class={`${tapeStyleTxt} -top-3 -left-2 md:-left-4 -rotate-[15deg]`}
          >
          </div>
          <div
            class={`${tapeStyleTxt} -bottom-3 -right-2 md:-right-4 -rotate-[10deg]`}
          >
          </div>

          <h3
            class="text-xl md:text-2xl font-bold text-third mb-6 flex items-center justify-center lg:justify-start gap-2"
          >
            Je m'appelle Sandrine
          </h3>

          <div
            class="text-base md:text-lg leading-relaxed text-gray-700 font-medium space-y-4 text-justify md:text-left"
            style="font-family: 'Comic Sans MS', 'cursive', sans-serif;"
          >
            <p>
              Pour moi, une maison sans animaux est une maison à laquelle il
              manque une âme. J'ai toujours aimé être entourée de vie, qu'il
              s'agisse de poils, de plumes ou d'écailles.
            </p>
            <p>
              Au fil des années, mes compagnons de route ont été variés —
              chiens, chats, rongeurs, oiseaux... Chacun, avec son caractère
              unique, a enrichi ma vie et affiné ma sensibilité.
            </p>
            <p>
              En me confiant votre animal, vous ne faites pas appel à un simple
              prestataire, mais à une personne qui le considérera, le temps de
              votre absence, comme un membre de sa propre famille.
            </p>
          </div>
        </div>

        <div class="flex flex-col items-center lg:items-start">
          <TapedIllustration
            imageUrl="/illustrations/mensignac.jpg"
            alt="Superbe vue de la nature autour de Mensignac en Dordogne, lieu des promenades"
            width="w-full max-w-sm md:max-w-md"
            height="h-56 md:h-64"
          />
          <p
            class="text-sm md:text-base text-gray-500 mt-4 font-medium italic items-center flex gap-2"
          >
            <Icon name="mdi:map-marker-outline" class="w-5 h-5 text-third" />
            Située à Mensignac
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
