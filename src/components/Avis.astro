---
import AvisCard from "./shared/AvisCard.astro";
import Vignette from "./shared/Vignette.astro";
const photos = [
  { src: "/illustrations/vignettes/dog-bird1.jpg", alt: "Photo 1", rot: -2 },
  { src: "/illustrations/vignettes/dog1.jpg", alt: "Photo 2", rot: 1.5 },
  { src: "/illustrations/vignettes/dog2.jpg", alt: "Photo 3", rot: -1 },
  { src: "/illustrations/vignettes/dog-sitter1.jpg", alt: "Photo 1", rot: 3.5 },
  { src: "/illustrations/vignettes/dog3.jpg", alt: "Photo 2", rot: -3 },
  { src: "/illustrations/vignettes/dog4.jpg", alt: "Photo 3", rot: 1 },
  { src: "/illustrations/vignettes/bird1.jpg", alt: "Photo 1", rot: -2.5 },
  { src: "/illustrations/vignettes/dog-sitter2.jpg", alt: "Photo 2", rot: 4 },
  { src: "/illustrations/vignettes/dog5.jpg", alt: "Photo 3", rot: -1.5 },
];
---

<section id="petphoto">
  <div class="container mx-auto px-4 py-10">
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Ce que <span class="text-third">les clients</span> pensent de moi
      </h2>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Voici quelques retours des personnes qui m'ont fait confiance :
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <AvisCard
        title="Bonne petsitter"
        description="Quel plaisir de partir en vacances l'esprit tranquille en sachant que notre toutou est chouchouté, câliné et serein. Sandrine a pris soin de Bella pendant 3 jours, avec des balades, des câlins et pleins de photos et de messages pour moi. J'ai été rassurée chaque jour par Sandrine. Bella a trouvé un bon accueil et reviendra chez Sandrine pour nos  prochaines vacances. Je recommande Sandrine 👍"
        author="Koléana"
      />

      <AvisCard
        title="Je recommande vivement ! "
        description="Excellente expérience! Sandrine a gardé mon chien 4 jours : accueil comme à la maison. Bons soins et cocooning garantis... D'autant plus que mon chien est épileptique et a fait une crise pendant son séjour. Elle a su gérer la situation avec beaucoup de professionnalisme et de compréhension. A recommander +++"
        author="Véronique"
      />

      <AvisCard
        title="Une personne professionnelle ! "
        description="Je recommanderais Sandrine sans hésiter pour garder votre chien. Pendant mon séjour estival en France, j'ai fait appel à ses services à plusieurs reprises, notamment pour une semaine complète, et mon chien Ford était toujours ravi d'y retourner. Il était évident qu'il se sentait parfaitement à l'aise avec elle et qu'il était bien pris en charge. Même si mon français n'est pas très bon, la communication était facile grâce aux SMS et aux outils de traduction, et Sandrine était toujours patiente et compréhensive. Elle a un caractère calme et attentionné, et elle a mis Ford et moi à l'aise dès le début. Je savais qu'il recevait beaucoup d'attention, de promenades et d'affection, ce qui m'a permis d'avoir l'esprit tranquille pendant mon absence. Je n'hésiterais pas à la recommander à quiconque recherche une gardienne de chien fiable et aimante.🐾"
        author="Pascal"
      />
    </div>

    <div
      class="mt-16 bg-white p-8 shadow-[2px_4px_15px_rgba(0,0,0,0.08)] rounded-sm border border-gray-100 max-w-2xl mx-auto text-center relative rotate-1 hover:rotate-0 transition duration-300"
    >
      <div
        class="absolute w-12 h-5 bg-third shadow-sm backdrop-blur-[1px] pointer-events-none opacity-70 -top-2 left-1/2 -translate-x-1/2 -rotate-3"
      >
      </div>
      <h3 class="text-2xl font-bold text-third mb-4">Mille mercis</h3>
      <p class="text-gray-700 italic">
        "Votre confiance est ma plus belle récompense. Chaque nouveau
        pensionnaire est une belle rencontre."
      </p>
      <p class="mt-4 font-bold text-lg">- Sandrine</p>
    </div>
  </div>
</section>
