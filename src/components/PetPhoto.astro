---
import Vignette from "./shared/Vignette.astro";
import { homePhotos as photos } from "../data/photos";
---

<section id="petphoto">
  <div class="container mx-auto px-4 py-10">
    <div class="text-center mb-12 max-w-2xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">
        Des nouvelles <span class="text-third">en images</span>
      </h2>
      <p class="text-lg text-muted-foreground leading-relaxed">
        Parce que je sais qu'ils vous manquent, je capture leurs moments de vie
        et de jeu. Recevez régulièrement des photos de vos compagnons pour avoir
        l'esprit tranquille et l'assurance qu'ils sont choyés en votre absence.
      </p>
    </div>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-x-8 gap-y-12 p-10 justify-items-center"
    >
      {
        photos.map((p, index) => (
          <div key={index} class={index >= 5 ? "hidden md:block" : "block"}>
            <Vignette imageUrl={p.src} alt={p.alt} rotation={p.rot} />
          </div>
        ))
      }
    </div>
  </div>
</section>
