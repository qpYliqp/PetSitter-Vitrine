---
import Illusatrion from "./shared/Illusatrion.astro";
import CertificationBadge from "./shared/CertificationBadge.astro";
import Button from "./shared/Button.astro";
import { Icon } from "astro-icon/components";
---

<section id="home" class="pt-32 pb-10 md:pt-40 md:pb-20 relative">
  <div class="container px-4 mx-auto">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div
        class="flex-col items-center md:items-start flex gap-8 text-center md:text-start"
      >
        <CertificationBadge
          text="Certifiée par l'ACACED"
          iconName="certified-diploma"
        />
        <h1 class="text-4xl md:text-5xl lg:text-6xl max-w-2xl">
          <span class="text-third font-black block text-2xl lg:text-3xl mb-2 opacity-90 uppercase tracking-wider">Pet Sitter en Dordogne</span>
          Gardiennage de Chiens &amp; <span class="text-third">Pension Canine</span>
        </h1>
        <p class="text-muted-foreground text-lg font-medium">
          Confiez votre animal de compagnie à Sandrine, amoureuse des bêtes et <strong>pet sitter certifiée ACACED</strong>. Que ce soit pour un gardiennage de longue durée ou une pension de jour.
        </p>
        <p class="text-muted-foreground">
          Située à <strong>Mensignac</strong>, près de <strong>Périgueux (24)</strong>, j'accueille vos compagnons dans une véritable <strong>maison familiale avec jardin clos</strong>. Loin des conditions des chenils traditionnels, votre chien profite ici d'un environnement aimant, totalement sécurisé, avec sorties, balades et de l'affection garanti. Vacances sans stress pour vous comme pour eux.
        </p>
        <div class="flex items-center gap-5 text-sm md:text-md">
          <Button buttonText="Contactez-moi" />
          <div class="h-fit"></div>
        </div>
        <div
          class="flex flex-row **items-center** justify-center md:justify-start w-full text-center md:text-start gap-3 md:gap-8 pt-4"
        >
          <div class="flex flex-col w-1/2 lg:w-fit md:items-start">
            <div
              class="flex border-t items-center justify-center md:justify-start border-secondary"
            >
              <Icon name="star" class="w-4 h-4 text-third" />
              <Icon name="star" class="w-4 h-4 text-third" />
              <Icon name="star" class="w-4 h-4 text-third" />
              <Icon name="star" class="w-4 h-4 text-third" />
              <Icon name="star" class="w-4 h-4 text-third" />
            </div>
            <p class="text-sm text-muted-foreground">
              Plus de <span class="text-third">30 clients satisfaits</span>
            </p>
          </div>

          <div class="h-12 w-px bg-third"></div>

          <div class="flex flex-col w-1/2 lg:w-fit md:items-start">
            <div
              class="flex border-t gap-2 items-center justify-center md:justify-start border-secondary"
            >
              <Icon name="heart" class="w-4 h-4 text-third" />
              <Icon name="heart" class="w-4 h-4 text-third" />
              <Icon name="heart" class="w-4 h-4 text-third" />
            </div>
            <p class="text-sm text-muted-foreground">
              Animaux <span class="text-third">100% heureux</span>
            </p>
          </div>
        </div>
      </div>
      <div class="relative">
        <Illusatrion imageUrl="/illustrations/kenzo1.jpg" />
      </div>
    </div>
  </div>
</section>
