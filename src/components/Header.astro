---
const pathname = Astro.url.pathname;
const currentPath = pathname === "/" ? pathname : pathname.replace(/\/$/, "");
---

<header
  id="main-header"
  class="fixed top-0 z-50 w-full transition-all duration-300 ease-in-out px-4 md:px-6 py-4 md:py-5 bg-transparent text-font-primary"
>
  <div
    class="max-w-7xl mx-auto flex justify-between items-center gap-3 md:gap-0"
  >
    <a href="/" class="flex items-center gap-2 md:gap-3 group">
      <img
        src="/favicon.svg"
        alt="Logo PetSitter24"
        class="w-10 h-10 md:w-12 md:h-12 object-contain"
      />
      <span class="text-xl md:text-2xl font-extrabold tracking-tight">
        Au bonheur<span class="text-third"> Canin</span>
      </span>
    </a>

    <nav
      class="hidden md:flex gap-8 font-medium items-center text-font-primary"
    >
      <a
        href="/#home"
        class={`hover:text-third hover:-translate-y-0.5 transition-all ${currentPath === "/" ? "text-third font-bold" : ""}`}
        >Accueil</a
      >

      <a
        href="/galerie"
        class={`hover:text-third hover:-translate-y-0.5 transition-all relative group py-1 ${currentPath === "/galerie" ? "text-third font-bold" : ""}`}
      >
        Galerie
        <span
          class={`absolute bottom-0 left-0 h-0.5 bg-third transition-all duration-300 ${currentPath === "/galerie" ? "w-full" : "w-0 group-hover:w-full"}`}
        ></span>
      </a>

      <a
        href="/tarifs"
        class={`hover:text-third hover:-translate-y-0.5 transition-all relative group py-1 ${currentPath === "/tarifs" ? "text-third font-bold" : ""}`}
      >
        Tarifs
        <span
          class={`absolute bottom-0 left-0 h-0.5 bg-third transition-all duration-300 ${currentPath === "/tarifs" ? "w-full" : "w-0 group-hover:w-full"}`}
        ></span>
      </a>

      <a
        href="/contact"
        class={`hover:text-third hover:-translate-y-0.5 transition-all relative group py-1 ${currentPath === "/contact" ? "text-third font-bold" : ""}`}
      >
        Contact
        <span
          class={`absolute bottom-0 left-0 h-0.5 bg-third transition-all duration-300 ${currentPath === "/contact" ? "w-full" : "w-0 group-hover:w-full"}`}
        ></span>
      </a>
    </nav>

    <button
      id="mobile-menu-btn"
      aria-label="Menu"
      class="md:hidden flex flex-col justify-center items-center w-10 h-10 gap-[5px] z-60"
    >
      <span
        class="w-6 h-[2px] bg-font-primary transition-all duration-300 origin-center"
        id="line1"></span>
      <span
        class="w-6 h-[2px] bg-font-primary transition-all duration-300 origin-center"
        id="line2"></span>
      <span
        class="w-6 h-[2px] bg-font-primary transition-all duration-300 origin-center"
        id="line3"></span>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="md:hidden fixed inset-0 h-dvh bg-primary/98 backdrop-blur-xl z-50 flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-300 px-6"
  >
    <nav
      class="flex flex-col gap-8 font-bold items-center text-3xl text-font-primary text-center"
    >
      <a href="/#home" class="mobile-link hover:text-third transition-colors"
        >Accueil</a
      >
      <a href="/galerie" class="mobile-link hover:text-third transition-colors"
        >Galerie</a
      >
      <a href="/avis" class="mobile-link hover:text-third transition-colors"
        >Avis</a
      >
      <a href="/tarifs" class="mobile-link hover:text-third transition-colors"
        >Tarifs</a
      >
      <a
        href="/contact"
        class="mobile-link px-8 py-4 bg-third/15 text-third rounded-full mt-4 text-2xl"
        >Contact</a
      >
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("main-header") as HTMLElement;
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const line1 = document.getElementById("line1");
  const line2 = document.getElementById("line2");
  const line3 = document.getElementById("line3");
  const mobileLinks = document.querySelectorAll(".mobile-link");

  let isMenuOpen = false;

  const toggleMenu = () => {
    isMenuOpen = !isMenuOpen;

    if (isMenuOpen) {
      menu?.classList.remove("opacity-0", "pointer-events-none");
      menu?.classList.add("opacity-100", "pointer-events-auto");

      if (line1) line1.style.transform = "translateY(7px) rotate(45deg)";
      if (line2) line2.style.opacity = "0";
      if (line3) line3.style.transform = "translateY(-7px) rotate(-45deg)";

      document.body.style.overflow = "hidden";
    } else {
      menu?.classList.add("opacity-0", "pointer-events-none");
      menu?.classList.remove("opacity-100", "pointer-events-auto");

      if (line1) line1.style.transform = "none";
      if (line2) line2.style.opacity = "1";
      if (line3) line3.style.transform = "none";

      document.body.style.overflow = "";
    }
  };

  btn?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (isMenuOpen) toggleMenu();
    });
  });

  const handleScroll = () => {
    if (!header) return;

    if (window.scrollY > 20) {
      header.classList.remove("py-4", "md:py-5", "bg-transparent");
      header.classList.add(
        "py-2",
        "md:py-3",
        "bg-white/95",
        "backdrop-blur-md",
        "shadow-sm",
        "border-b",
        "border-third/20",
      );
    } else {
      header.classList.add("py-4", "md:py-5", "bg-transparent");
      header.classList.remove(
        "py-2",
        "md:py-3",
        "bg-white/95",
        "backdrop-blur-md",
        "shadow-sm",
        "border-b",
        "border-third/20",
      );
    }
  };

  window.addEventListener("scroll", handleScroll);
  handleScroll();
</script>
