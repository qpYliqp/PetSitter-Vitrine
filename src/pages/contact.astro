---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TapedIllustration from "../components/shared/TapedIllustration.astro";
import ContactLink from "../components/shared/ContactLink.astro";
import "../styles/global.css";

const tapeStyleTxt =
  "absolute w-12 md:w-16 h-5 md:h-6 bg-third shadow-sm backdrop-blur-[1px] pointer-events-none opacity-70";
---

<Layout>
  <Header />
  <main
    class="min-h-screen pt-24 pb-12 relative overflow-hidden flex items-center"
  >
    <!-- Fond texturé -->
    <div
      class="absolute inset-0 -z-10 opacity-5 bg-[url('/illustrations/paper-texture.png')] bg-repeat mix-blend-multiply"
    >
    </div>

    <div class="container mx-auto px-4 max-w-7xl">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
      >
        <!-- Colonne Gauche: Infos & Illustration -->
        <div
          class="flex flex-col items-center lg:items-start gap-8 text-center lg:text-start"
        >
          <h1 class="text-4xl md:text-5xl font-bold mb-2 relative inline-block">
            Parlons de
            <span class="text-third relative z-10">vous</span>
            <svg
              class="absolute bottom-0 left-0 w-full h-3 -z-10 text-third/30"
              viewBox="0 0 100 10"
              preserveAspectRatio="none"
            >
              <path
                d="M0 5 Q 25 0, 50 5 T 100 5"
                stroke="currentColor"
                stroke-width="3"
                fill="none"
                stroke-linecap="round"></path>
            </svg>
          </h1>

          <p
            class="text-lg text-gray-700 leading-relaxed max-w-lg font-medium"
            style="font-family: 'Comic Sans MS', 'cursive', sans-serif;"
          >
            N'hésitez pas à me contacter pour toute question, demande de devis
            ou pour planifier une première rencontre avec votre petit protégé !
          </p>

          <div
            class="bg-gray-800 rounded-2xl p-6 w-full max-w-md shadow-2xl flex flex-col gap-4 transform transition-transform hover:scale-[1.02]"
          >
            <ContactLink
              label="Phone"
              iconName="mdi:phone"
              link="tel:+33622073356"
              userName="06 00 00 00 00"
            />
            <ContactLink
              label="Email"
              iconName="mdi:email"
              link="mailto:votre@email.com"
              userName="votre@email.com"
            />
            <ContactLink
              label="Location"
              iconName="mdi:map-marker"
              link="#"
              userName="Mensignac, Dordogne"
            />
          </div>

          <div
            class="hidden lg:block relative z-10 mt-8 transform transition-transform hover:scale-[1.02] duration-300 rotate-2"
          >
            <TapedIllustration
              imageUrl="/illustrations/contact-dog.jpg"
              width="w-72"
              height="h-56"
            />
          </div>
        </div>

        <!-- Colonne Droite: Formulaire (Style Papier) -->
        <div
          class="relative transition hover:scale-[1.01] duration-300 ease-out bg-white p-8 md:p-12 shadow-[2px_4px_25px_rgba(0,0,0,0.1)] rounded-sm border border-gray-100 max-w-xl mx-auto w-full"
        >
          <!-- Petits scotchs décoratifs -->
          <div class={`${tapeStyleTxt} -top-3 -left-2 md:-left-4 -rotate-15`}>
          </div>
          <div
            class={`${tapeStyleTxt} -bottom-3 -right-2 md:-right-4 -rotate-10`}
          >
          </div>

          <h3 class="text-2xl font-bold text-third mb-8 text-center">
            Envoyez-moi un message
          </h3>

          <form class="space-y-6">
            <div class="space-y-2">
              <label for="name" class="block text-sm font-bold text-gray-700"
                >Nom & Prénom</label
              >
              <input
                type="text"
                id="name"
                name="name"
                class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-third bg-gray-50 transition-colors"
                placeholder="Jean Dupont"
                required
              />
            </div>
            <div class="space-y-2">
              <label for="email" class="block text-sm font-bold text-gray-700"
                >Adresse Email</label
              >
              <input
                type="email"
                id="email"
                name="email"
                class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-third bg-gray-50 transition-colors"
                placeholder="jean@exemple.com"
                required
              />
            </div>
            <div class="space-y-2">
              <label for="subject" class="block text-sm font-bold text-gray-700"
                >Objet du message</label
              >
              <input
                type="text"
                id="subject"
                name="subject"
                class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-third bg-gray-50 transition-colors"
                placeholder="Garde d'un Golden Retriever en Août"
                required
              />
            </div>
            <div class="space-y-2">
              <label for="message" class="block text-sm font-bold text-gray-700"
                >Votre Message</label
              >
              <textarea
                id="message"
                name="message"
                rows="5"
                class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-third bg-gray-50 transition-colors resize-none"
                placeholder="Dites-m'en plus sur votre chien, son caractère, et vos besoins précis..."
                required></textarea>
            </div>
            <button
              type="submit"
              class="w-full px-5 py-4 bg-third text-white font-bold rounded-xl transition duration-300 ease-in-out shadow-lg hover:shadow-xl hover:scale-[1.02] cursor-pointer"
            >
              Envoyer le message
            </button>
          </form>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
