---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import Home from "../components/Home.astro";
import Services from "../components/Services.astro";
import Environement from "../components/Environement.astro";
import PetPhoto from "../components/PetPhoto.astro";
import AboutMe from "../components/AboutMe.astro";
import Avis from "../components/Avis.astro";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";
import FAQ from "../components/FAQ.astro";
import { faqSchema } from "../data/faq";
---

<Layout
  title="Pet Sitter Dordogne | Gardiennage Chien & Pension à Mensignac"
  description="Recherche un Pet Sitter en Dordogne ? Sandrine vous propose le gardiennage de chiens, pension canine sans box et garde d'animaux à Mensignac, près de Périgueux."
  faqSchema={faqSchema}
>
  <Header />
  <Home />
  <Services />
  <Environement />
  <PetPhoto />
  <AboutMe />
  <Avis />
  <FAQ />
  <Contact />
  <Footer />
</Layout>
