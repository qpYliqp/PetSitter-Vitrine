---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Vignette from "../components/shared/Vignette.astro";
import LargeVignette from "../components/shared/LargeVignette.astro";
import TapedIllustration from "../components/shared/TapedIllustration.astro";
import "../styles/global.css";

const tapeStyleTxt =
  "absolute w-12 md:w-16 h-5 md:h-6 bg-third shadow-sm backdrop-blur-[1px] pointer-events-none opacity-70";

const photos = [
  { src: "/illustrations/vignettes/dog-bird1.jpg", alt: "Photo 1", rot: -2 },
  { src: "/illustrations/vignettes/dog1.jpg", alt: "Photo 2", rot: 1.5 },
  { src: "/illustrations/vignettes/dog2.jpg", alt: "Photo 3", rot: -1 },
  { src: "/illustrations/vignettes/dog-sitter1.jpg", alt: "Photo 1", rot: 3.5 },
  { src: "/illustrations/vignettes/dog3.jpg", alt: "Photo 2", rot: -3 },
  { src: "/illustrations/vignettes/dog4.jpg", alt: "Photo 3", rot: 1 },
  { src: "/illustrations/vignettes/bird1.jpg", alt: "Photo 1", rot: -2.5 },
  { src: "/illustrations/vignettes/dog-sitter2.jpg", alt: "Photo 2", rot: 4 },
  { src: "/illustrations/vignettes/dog5.jpg", alt: "Photo 3", rot: -1.5 },
];
---

<Layout>
  <Header />
  <main class="min-h-screen pt-24 pb-20 relative overflow-hidden">
    <div class="absolute inst-0 -z-10 opacity-5"></div>

    <div class="container mx-auto px-4 max-w-5xl">
      <div
        class="flex flex-col items-center gap-8 text-center mb-16 relative pt-"
      >
        <h1 class="text-4xl md:text-5xl font-bold mb-2 relative inline-block">
          Des souvenirs
          <span class="text-third relative z-10">inoubliables</span>
        </h1>

        <p
          class="text-lg text-muted-foreground leading-relaxed max-w-2xl text-center mb-8"
          style="font-family: 'Comic Sans MS', 'cursive', sans-serif;"
        >
          Découvrez tous les moments de joie, de jeu et de repos partagés avec
          vos adorables compagnons ! Parce que des images valent souvent mieux
          que de longs discours.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 p-4 md:p-8 items-stretch justify-center relative max-w-6xl mx-auto mt-4"
      >
        {photos.map((p) => <LargeVignette imageUrl={p.src} alt={p.alt} />)}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
