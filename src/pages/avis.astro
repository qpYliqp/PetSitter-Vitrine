---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AvisCard from "../components/shared/AvisCard.astro";
import "../styles/global.css";
---

<Layout>
  <Header />
  <main class="min-h-screen pt-24 pb-12 relative overflow-hidden">
    <!-- Fond texturé -->
    <div
      class="absolute inset-0 -z-10 opacity-5 bg-[url('/illustrations/paper-texture.png')] bg-repeat mix-blend-multiply"
    >
    </div>

    <div class="container mx-auto px-4">
      <div class="flex flex-col items-center gap-8 text-center mb-16 relative">
        <h1
          class="text-4xl md:text-5xl font-bold mb-2 relative inline-block mt-8"
        >
          Leurs avis <span class="text-third relative z-10">comptent</span>
          <svg
            class="absolute bottom-0 left-0 w-full h-3 -z-10 text-third/30"
            viewBox="0 0 100 10"
            preserveAspectRatio="none"
          >
            <path
              d="M0 5 Q 25 0, 50 5 T 100 5"
              stroke="currentColor"
              stroke-width="3"
              fill="none"
              stroke-linecap="round"></path>
          </svg>
        </h1>

        <div
          class="mt-16 bg-white p-8 shadow-[2px_4px_15px_rgba(0,0,0,0.08)] rounded-sm border border-gray-100 max-w-2xl mx-auto text-center relative rotate-1 hover:rotate-0 transition duration-300"
        >
          <div
            class="absolute w-12 h-5 bg-third shadow-sm backdrop-blur-[1px] pointer-events-none opacity-70 -top-2 left-1/2 -translate-x-1/2 -rotate-3"
          >
          </div>
          <h3 class="text-2xl font-bold text-third mb-4">Mille mercis</h3>
          <p class="text-gray-700 italic">
            "Votre confiance est ma plus belle récompense. Chaque nouveau
            pensionnaire est une belle rencontre."
          </p>
          <p class="mt-4 font-bold text-lg">- Sandrine</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 py-8 items-start">
        <AvisCard
          title="Bonne petsitter"
          description="Sandrine s'est bien occupée de notre chienne et qui a donné de ses nouvelles chaques jour avec un petit commentaire et des photos et vidéos."
          author="Evelyne"
        />

        <AvisCard
          title="Très satisfaite"
          description="J'ai confié ma chienne Vicky à Sandrine pour la journée et tout s'est parfaitement bien passé ! Elle a été très arrangeante, réactive et vraiment attentionnée. J'ai eu des nouvelles et une photo pendant la garde, ce qui m'a tout de suite rassurée. Vicky avait l'air heureuse et détendue à son retour, ce qui en dit long."
          author="Lydie N."
        />

        <AvisCard
          title="Je recommande vivement ! "
          description="Nous avons laissé notre toutout, qui est terriblement attaché à notre foyer et à horreur de la solitude, à qui il a trouvé en Sandrine beaucoup d'affection et d'amour. Il s'est très vite senti en confiance et nous est revenu heureux. Merci Sandrine."
          author="Florian D."
        />

        <AvisCard
          title="Une professionnelle en or"
          description="Première fois que nous laissons notre chat plus de 3 jours, et Sandrine a su trouver les mots pour nous rassurer. Le cadre est magnifique et sécurisant. Une vraie nounou !"
          author="Marie P."
        />

        <AvisCard
          title="Parfaitement adapté"
          description="Mon Terre-neuve a besoin d'espace et de se dépenser. Grâce au grand jardin clos, il a pu courir et s'amuser toute la semaine sans problème. C'est l'endroit idéal."
          author="Benoît L."
        />

        <AvisCard
          title="Toujours ravie"
          description="Je confie mes deux bergers australiens à Sandrine à chaque vacances. Ils lui font la fête en arrivant et je pars l'esprit totalement libéré sachant qu'ils sont entre de bonnes mains."
          author="Sophie G."
        />
      </div>
    </div>
  </main>
  <Footer />
</Layout>
